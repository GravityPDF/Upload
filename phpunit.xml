<!-- convertDeprecationsToExceptions, because a deprecation raised from src/ otherwise passes
     straight through a green run: `$file[] = $fileInfo` wrote a string key and warned about it
     on PHP 8.5 for a release, with the suite reporting OK. This library supports 7.3 to 8.5,
     which is the range where a deprecation is the notice before the break. -->
<phpunit backupGlobals="true"
         convertDeprecationsToExceptions="true"
         failOnWarning="true"
         failOnRisky="true"
         colors="true"
         bootstrap="tests/bootstrap.php">
   <testsuites>
        <testsuite name="Upload Test Suite">
            <directory>./tests/</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory>./src/Upload/</directory>
        </include>
    </coverage>
</phpunit>
