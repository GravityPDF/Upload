{
  "name": "gravitypdf/upload",
  "type": "library",
  "description": "Handle file uploads with extensible validation and storage strategies",
  "keywords": [
    "upload",
    "validation",
    "file"
  ],
  "homepage": "https://github.com/gravitypdf/upload",
  "license": "MIT",
  "authors": [
    {
      "name": "Josh Lockhart",
      "email": "info@joshlockhart.com",
      "homepage": "https://github.com/codeguy/"
    },
    {
      "name": "Gravity PDF",
      "homepage": "https://github.com/GravityPDF/"
    }
  ],
  "support": {
    "issues": "https://github.com/gravitypdf/upload/issues",
    "source": "https://github.com/gravitypdf/upload"
  },
  "require": {
    "php": "^7.3 || ~8.0.0 || ~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
    "ext-fileinfo": "*"
  },
  "suggest": {
    "ext-mbstring": "Truncates sanitized filenames on a character boundary and guarantees they are valid UTF-8"
  },
  "require-dev": {
    "yoast/phpunit-polyfills": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.3",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "GravityPdf\\Upload\\": "src/Upload"
    },
    "files": [
      "src/Upload/i18n.php"
    ]
  },
  "scripts": {
    "check-syntax": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor --exclude tools/phpstan/vendor --exclude tools/psr7-readme/vendor --exclude tools/translator-readme/vendor .",
    "i18n:pot": "@php tools/i18n/generate-pot.php",
    "lint": "@php ./vendor/bin/phpcs --standard=PSR12 ./src/ ./tests/ ./tools/i18n/ ./tools/psr7-readme/verify.php ./tools/translator-readme/verify.php ./tools/translator-readme/marker-import.php ./tools/translator-readme/global-underscore.php",
    "lint:fix": "@php ./vendor/bin/phpcbf --standard=PSR12 ./src/ ./tests/ ./tools/i18n/ ./tools/psr7-readme/verify.php ./tools/translator-readme/verify.php ./tools/translator-readme/marker-import.php ./tools/translator-readme/global-underscore.php",
    "phpstan": [
      "@composer install --working-dir=tools/phpstan --no-interaction --quiet",
      "@php tools/phpstan/vendor/bin/phpstan analyse"
    ],
    "phpunit": "@php ./vendor/bin/phpunit",
    "psr7-readme": [
      "@composer update --working-dir=tools/psr7-readme --no-interaction --quiet",
      "@php tools/psr7-readme/verify.php"
    ],
    "translator-readme": [
      "@composer update --working-dir=tools/translator-readme --no-interaction --quiet",
      "@php tools/translator-readme/verify.php"
    ]
  },
  "replace": {
    "codeguy/upload": "1.3.2"
  }
}
